name: Экраны приложения

children:
  - id: note.home
    type: text
    position: [ 80, 82 ]
    size: [ hug, hug ]
    fontFamily: Manrope
    fontSize: 34
    fontWeight: 700
    color: "#000000"
    content: Главная

  - id: screen.home
    type: frame
    position: [ 80, 150 ]
    size: [ 402, hug ]
    layout: { type: flex, direction: column }
    fill: $color.canvas
    children:
      - id: home.content
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 20, padding: [ 24, 20, 28, 20 ] }
        children:
          - id: home.header
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
            children:
              - id: home.header.texts
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 5 }
                children:
                  - {
                      id: home.header.overline,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.overline,
                      content: "ВОСКРЕСЕНЬЕ, 15 НОЯБРЯ"
                    }
                  - {
                      id: home.header.title,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Cormorant,
                      fontSize: 30,
                      fontWeight: 500,
                      lineHeight: 34,
                      color: $color.ink,
                      content: "Здравствуй, бурмалда"
                    }
                  - {
                      id: home.header.sub,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: "Лаконичный мужской уход и зона бритья"
                    }
              - id: home.avatar
                type: frame
                size: [ 46, 46 ]
                children:
                  - id: home.avatar.circle
                    type: frame
                    position: [ 0, 0 ]
                    size: [ 46, 46 ]
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    fill: $color.brassSoft
                    cornerRadius: 999
                    children:
                      - {
                          id: home.avatar.initials,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Cormorant,
                          fontSize: 19,
                          fontWeight: 600,
                          color: $color.brassDeep,
                          content: "БУ"
                        }
                  - {
                      id: home.avatar.dot,
                      type: ellipse,
                      position: [ 33, 34 ],
                      size: [ 11, 11 ],
                      fill: $color.sage,
                      stroke: { color: $color.canvas, width: 2 }
                    }
          - id: home.skin
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 16, padding: 20 }
            fill: $color.dark
            cornerRadius: 20
            effects: $shadow.card
            children:
              - id: home.skin.top
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, justifyContent: spaceBetween, alignItems: start }
                children:
                  - id: home.skin.texts
                    type: frame
                    size: [ hug, hug ]
                    layout: { type: flex, direction: column, gap: 5 }
                    children:
                      - {
                          id: home.skin.overline,
                          type: text,
                          size: [ hug, hug ],
                          style: $text.overline,
                          color: $color.brassLight,
                          content: "ИНДЕКС КОЖИ"
                        }
                      - {
                          id: home.skin.value,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Cormorant,
                          fontSize: 27,
                          fontWeight: 500,
                          lineHeight: 30,
                          color: $color.ivory,
                          content: "Пока не определён"
                        }
                      - {
                          id: home.skin.hint,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 12,
                          lineHeight: 16,
                          color: $color.ivoryDim,
                          content: "Сделай первый AI-скан"
                        }
                  - id: home.skin.streak
                    type: frame
                    size: [ hug, hug ]
                    layout: { type: flex, gap: 6, padding: [ 7, 12 ], alignItems: center }
                    fill: $color.darkSoft
                    cornerRadius: 999
                    children:
                      - {
                          id: home.skin.streak.icon,
                          type: svg,
                          size: [ 11, 11 ],
                          icon: "fas:fire",
                          fill: "#D97B52"
                        }
                      - {
                          id: home.skin.streak.text,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 12,
                          fontWeight: 600,
                          color: $color.ivory,
                          content: "0 дней"
                        }
              - id: home.skin.track
                type: frame
                size: [ fill, 4 ]
                layout: { type: free, overflow: hidden }
                fill: $color.darkSoft
                cornerRadius: 999
                children:
                  - {
                      id: home.skin.track.fill,
                      type: rect,
                      position: [ 0, 0 ],
                      size: [ 48, 4 ],
                      cornerRadius: 999,
                      fill: $color.brass
                    }
              - {
                  id: home.skin.divider,
                  type: rect,
                  size: [ fill, 1 ],
                  fill: $color.lineDark
                }
              - id: home.skin.meta
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
                children:
                  - id: home.skin.meta.left
                    type: frame
                    size: [ hug, hug ]
                    layout: { type: flex, gap: 8, alignItems: center }
                    children:
                      - {
                          id: home.skin.meta.face,
                          type: svg,
                          size: [ 13, 13 ],
                          icon: "far:face-smile",
                          fill: $color.sageLight
                        }
                      - {
                          id: home.skin.meta.skintype,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          color: $color.ivoryDim,
                          content: "Кожа: нормальная"
                        }
                  - id: home.skin.meta.right
                    type: frame
                    size: [ hug, hug ]
                    layout: { type: flex, gap: 6, alignItems: center }
                    children:
                      - {
                          id: home.skin.meta.shield,
                          type: svg,
                          size: [ 12, 12 ],
                          icon: "fas:shield-halved",
                          fill: $color.sageLight
                        }
                      - {
                          id: home.skin.meta.clean,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 12,
                          color: $color.ivoryDim,
                          content: "Чистый профиль"
                        }
          - id: home.hero
            type: frame
            size: [ fill, 200 ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                padding: [ 18, 20 ],
                justifyContent: end,
                overflow: hidden
              }
            cornerRadius: 20
            fill:
              - type: image
                src: assets/hero-skincare.png
                fit: cover
                position: [ 0.5, 0.35 ]
              - type: linearGradient
                angle: 90
                stops:
                  - [ 0, "#14100B00" ]
                  - [ 0.45, "#14100B8C" ]
                  - [ 1, "#14100BE6" ]
            children:
              - {
                  id: home.hero.overline,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.overline,
                  color: $color.brassLight,
                  content: "МУЖСКОЙ КОНСЬЕРЖ"
                }
              - {
                  id: home.hero.title,
                  type: text,
                  size: [ fill, hug ],
                  fontFamily: Cormorant,
                  fontSize: 27,
                  fontWeight: 500,
                  lineHeight: 30,
                  color: $color.ivory,
                  content: "Лаконичный уход для кожи"
                }
          - id: home.actions
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column }
            fill: $color.surface
            cornerRadius: 20
            effects: $shadow.card
            children:
              - id: home.action.scan
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, gap: 14, padding: [ 16, 18 ], alignItems: center }
                children:
                  - id: home.action.scan.tile
                    type: frame
                    size: [ 42, 42 ]
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    fill: $color.brassSoft
                    cornerRadius: 12
                    children:
                      - {
                          id: home.action.scan.icon,
                          type: svg,
                          size: [ 17, 17 ],
                          icon: "fas:face-smile",
                          fill: $color.brassDeep
                        }
                  - id: home.action.scan.texts
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 3 }
                    children:
                      - {
                          id: home.action.scan.title,
                          type: text,
                          size: [ fill, hug ],
                          fontFamily: Manrope,
                          fontSize: 15,
                          fontWeight: 600,
                          color: $color.ink,
                          content: "AI-диагностика кожи лица"
                        }
                      - {
                          id: home.action.scan.caption,
                          type: text,
                          size: [ fill, hug ],
                          style: $text.caption,
                          content: "Селфи-анализ и персональный подбор"
                        }
                  - {
                      id: home.action.scan.chevron,
                      type: svg,
                      size: [ 13, 13 ],
                      icon: "fas:chevron-right",
                      fill: $color.brass
                    }
              - {
                  id: home.actions.divider,
                  type: rect,
                  size: [ fill, 1 ],
                  margin: [ 0, 18, 0, 74 ],
                  fill: $color.line
                }
              - id: home.action.inci
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, gap: 14, padding: [ 16, 18 ], alignItems: center }
                children:
                  - id: home.action.inci.tile
                    type: frame
                    size: [ 42, 42 ]
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    fill: $color.brassSoft
                    cornerRadius: 12
                    children:
                      - {
                          id: home.action.inci.icon,
                          type: svg,
                          size: [ 16, 16 ],
                          icon: "fas:flask",
                          fill: $color.brassDeep
                        }
                  - id: home.action.inci.texts
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 3 }
                    children:
                      - {
                          id: home.action.inci.title,
                          type: text,
                          size: [ fill, hug ],
                          fontFamily: Manrope,
                          fontSize: 15,
                          fontWeight: 600,
                          color: $color.ink,
                          content: "Проверить банку по фото"
                        }
                      - {
                          id: home.action.inci.caption,
                          type: text,
                          size: [ 235, hug ],
                          style: $text.caption,
                          content: "INCI-скан комедогенности и конфликта активов"
                        }
                  - {
                      id: home.action.inci.chevron,
                      type: svg,
                      size: [ 13, 13 ],
                      icon: "fas:chevron-right",
                      fill: $color.brass
                    }
          - id: home.calendar
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 14 }
            children:
              - id: home.calendar.header
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
                children:
                  - id: home.calendar.month
                    type: frame
                    size: [ hug, hug ]
                    layout: { type: flex, gap: 8, alignItems: center }
                    children:
                      - {
                          id: home.calendar.month.icon,
                          type: svg,
                          size: [ 13, 13 ],
                          icon: "far:calendar",
                          fill: $color.brassDeep
                        }
                      - {
                          id: home.calendar.month.text,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 15,
                          fontWeight: 600,
                          color: $color.ink,
                          content: "Ноябрь 2026"
                        }
                  - id: home.calendar.nav
                    type: frame
                    size: [ hug, hug ]
                    layout: { type: flex, gap: 8 }
                    children:
                      - id: home.calendar.prev
                        type: frame
                        size: [ 32, 32 ]
                        layout: { type: flex, alignItems: center, justifyContent: center }
                        cornerRadius: 999
                        stroke: { color: $color.line, width: 1, alignment: inside }
                        children:
                          - {
                              id: home.calendar.prev.icon,
                              type: svg,
                              size: [ 12, 12 ],
                              icon: "fas:chevron-left",
                              fill: $color.inkSecondary
                            }
                      - id: home.calendar.next
                        type: frame
                        size: [ 32, 32 ]
                        layout: { type: flex, alignItems: center, justifyContent: center }
                        cornerRadius: 999
                        stroke: { color: $color.line, width: 1, alignment: inside }
                        children:
                          - {
                              id: home.calendar.next.icon,
                              type: svg,
                              size: [ 12, 12 ],
                              icon: "fas:chevron-right",
                              fill: $color.inkSecondary
                            }
              - id: home.calendar.week
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, gap: 6 }
                children:
                  - id: home.day.9
                    type: instance
                    source: day-cell
                    size: [ fill, 62 ]
                    values: { weekday: "ПН", num: "9" }
                  - id: home.day.10
                    type: instance
                    source: day-cell
                    size: [ fill, 62 ]
                    values: { weekday: "ВТ", num: "10" }
                  - id: home.day.11
                    type: instance
                    source: day-cell
                    size: [ fill, 62 ]
                    values: { weekday: "СР", num: "11" }
                  - id: home.day.12
                    type: instance
                    source: day-cell
                    size: [ fill, 62 ]
                    values: { weekday: "ЧТ", num: "12" }
                  - id: home.day.13
                    type: instance
                    source: day-cell
                    size: [ fill, 62 ]
                    values: { weekday: "ПТ", num: "13" }
                  - id: home.day.14
                    type: instance
                    source: day-cell
                    size: [ fill, 62 ]
                    values: { weekday: "СБ", num: "14" }
                  - id: home.day.15
                    type: instance
                    source: day-cell
                    size: [ fill, 62 ]
                    values: { active: true, weekday: "ВС", num: "15" }
          - id: home.routine
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 12 }
            children:
              - id: home.routine.head
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 5 }
                children:
                  - {
                      id: home.routine.overline,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.overline,
                      content: "ЕЖЕДНЕВНЫЙ УХОД"
                    }
                  - {
                      id: home.routine.title,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Cormorant,
                      fontSize: 24,
                      fontWeight: 500,
                      lineHeight: 28,
                      color: $color.ink,
                      content: "Воскресенье, 15 ноября"
                    }
                  - {
                      id: home.routine.caption,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: "План ухода ещё не сформирован"
                    }
              - id: home.routine.card
                type: frame
                size: [ fill, hug ]
                layout:
                  {
                    type: flex,
                    direction: column,
                    gap: 14,
                    padding: [ 26, 22 ],
                    alignItems: center
                  }
                fill: $color.surface
                cornerRadius: 20
                effects: $shadow.card
                children:
                  - id: home.routine.iconwrap
                    type: frame
                    size: [ 56, 56 ]
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    fill: $color.brassSoft
                    cornerRadius: 999
                    children:
                      - {
                          id: home.routine.icon,
                          type: svg,
                          size: [ 20, 20 ],
                          icon: "fas:wand-magic-sparkles",
                          fill: $color.brassDeep
                        }
                  - {
                      id: home.routine.headline,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.headline,
                      content: "Рутина пока пуста"
                    }
                  - {
                      id: home.routine.body,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 13,
                      lineHeight: 19,
                      color: $color.inkSecondary,
                      align: [ center, top ],
                      content: "Никаких чужих шаблонов: пройди AI-скан лица, добавь свои средства или
                        собери базовый уход по ответам анкеты."
                    }
                  - id: home.routine.buttons
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 10, padding: [ 6, 0, 0, 0 ] }
                    children:
                      - id: home.routine.cta
                        type: instance
                        source: button
                        size: [ fill, 52 ]
                        values:
                          label: "Провести AI-скан лица"
                          icon:
                            - {
                                id: home.routine.cta.icon,
                                type: svg,
                                size: [ 15, 15 ],
                                icon: "fas:face-smile",
                                fill: $color.onBtnPrimary
                              }
                      - id: home.routine.quiz
                        type: instance
                        source: button
                        size: [ fill, 52 ]
                        values: { kind: outline, label: "Подобрать уход по анкете" }
                      - {
                          id: home.routine.add,
                          type: text,
                          size: [ hug, hug ],
                          alignSelf: center,
                          fontFamily: Manrope,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $color.brassDeep,
                          content: "Добавить мои текущие средства"
                        }
      - id: home.tabbar
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column }
        children:
          - { id: home.tabbar.line, type: rect, size: [ fill, 1 ], fill: $color.line }
          - id: home.tabbar.items
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, padding: [ 13, 28, 16, 28 ], justifyContent: spaceBetween }
            children:
              - id: home.tab.home
                type: instance
                source: tab-item
                values:
                  active: true
                  icon:
                    - {
                        id: home.tab.home.icon,
                        type: svg,
                        size: [ 21, 21 ],
                        icon: "fas:house",
                        fill: $color.ink
                      }
              - id: home.tab.fav
                type: instance
                source: tab-item
                values:
                  icon:
                    - {
                        id: home.tab.fav.icon,
                        type: svg,
                        size: [ 21, 21 ],
                        icon: "far:heart",
                        fill: $color.inkTertiary
                      }
              - id: home.tab.cart
                type: instance
                source: tab-item
                values:
                  icon:
                    - {
                        id: home.tab.cart.icon,
                        type: svg,
                        size: [ 21, 21 ],
                        icon: "fas:bag-shopping",
                        fill: $color.inkTertiary
                      }
              - id: home.tab.profile
                type: instance
                source: tab-item
                values:
                  icon:
                    - {
                        id: home.tab.profile.icon,
                        type: svg,
                        size: [ 21, 21 ],
                        icon: "far:user",
                        fill: $color.inkTertiary
                      }
      - id: home.indicator
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, padding: [ 4, 0, 8, 0 ], justifyContent: center }
        children:
          - {
              id: home.indicator.bar,
              type: rect,
              size: [ 134, 5 ],
              cornerRadius: 999,
              fill: $color.homeIndicator
            }
  - id: note.favorites
    type: text
    position: [ 562, 82 ]
    size: [ hug, hug ]
    fontFamily: Manrope
    fontSize: 34
    fontWeight: 700
    color: "#000000"
    content: Избранное

  - id: screen.favorites
    type: frame
    position: [ 562, 150 ]
    size: [ 402, hug ]
    layout: { type: flex, direction: column }
    fill: $color.canvas
    children:
      - id: fav.content
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 20, padding: [ 24, 20, 28, 20 ] }
        children:
          - id: fav.header
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, justifyContent: spaceBetween, alignItems: end }
            children:
              - id: fav.header.texts
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 5 }
                children:
                  - {
                      id: fav.header.overline,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.overline,
                      content: "ПОДБОРКА"
                    }
                  - {
                      id: fav.header.title,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Cormorant,
                      fontSize: 30,
                      fontWeight: 500,
                      lineHeight: 34,
                      color: $color.ink,
                      content: "Избранный уход"
                    }
                  - {
                      id: fav.header.sub,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: "Средства, отобранные AI-консержем"
                    }
              - id: fav.header.count
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, gap: 6, padding: [ 8, 13 ], alignItems: center }
                fill: $color.surface
                cornerRadius: 999
                stroke: { color: $color.line, width: 1, alignment: inside }
                children:
                  - {
                      id: fav.header.count.icon,
                      type: svg,
                      size: [ 12, 12 ],
                      icon: "fas:heart",
                      fill: $color.brass
                    }
                  - {
                      id: fav.header.count.num,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 13,
                      fontWeight: 600,
                      color: $color.ink,
                      content: "2"
                    }
          - id: fav.scan
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 14, padding: [ 16, 18 ], alignItems: center }
            fill: $color.dark
            cornerRadius: 20
            effects: $shadow.card
            children:
              - id: fav.scan.tile
                type: frame
                size: [ 42, 42 ]
                layout: { type: flex, alignItems: center, justifyContent: center }
                fill: $color.darkSoft
                cornerRadius: 12
                children:
                  - {
                      id: fav.scan.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: "fas:flask",
                      fill: $color.brassLight
                    }
              - id: fav.scan.texts
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 3 }
                children:
                  - {
                      id: fav.scan.title,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 15,
                      fontWeight: 600,
                      color: $color.ivory,
                      content: "Проверить банку по составу"
                    }
                  - {
                      id: fav.scan.caption,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      lineHeight: 16,
                      color: $color.ivoryDim,
                      content: "Анализ INCI на комедогены и конфликт с уходом"
                    }
              - {
                  id: fav.scan.chevron,
                  type: svg,
                  size: [ 13, 13 ],
                  icon: "fas:chevron-right",
                  fill: $color.brassLight
                }
          - id: fav.note
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 10, padding: [ 2, 4 ], alignItems: start }
            children:
              - {
                  id: fav.note.icon,
                  type: svg,
                  size: [ 13, 13 ],
                  margin: [ 2, 0, 0, 0 ],
                  icon: "fas:wand-magic-sparkles",
                  fill: $color.brass
                }
              - {
                  id: fav.note.text,
                  type: text,
                  size: [ 328, hug ],
                  fontFamily: Manrope,
                  fontSize: 12.5,
                  lineHeight: 18,
