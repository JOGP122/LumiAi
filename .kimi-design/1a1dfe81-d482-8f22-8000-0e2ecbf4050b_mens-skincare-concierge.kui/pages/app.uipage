                      content: "Разбор состава"
                    }
          - id: inci.product
            type: instance
            source: product-card
            size: [ fill, hug ]
            values:
              name: "Сыворотка с ниацинамидом 10%"
              brand: "The Ordinary"
              price: "1 290 ₽"
              image: { type: image, src: assets/product-serum.png, fit: contain }
          - id: inci.verdict
            type: instance
            source: action-row
            size: [ fill, hug ]
            values:
              kind: dark
              title: "Подходит твоей коже"
              caption: "0 комедогенных, 1 умеренный конфликт"
              icon:
                - {
                    id: inci.verdict.icon,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: "fas:shield-halved",
                    fill: $color.brassLight
                  }
          - id: inci.list
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 12, padding: 18 }
            fill: $color.surface
            cornerRadius: 20
            effects: $shadow.card
            children:
              - id: inci.list.header
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
