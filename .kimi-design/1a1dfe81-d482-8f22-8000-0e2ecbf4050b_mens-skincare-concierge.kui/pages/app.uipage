                      id: inci.ing.1.dot,
                      type: ellipse,
                      size: [ 8, 8 ],
                      margin: [ 5, 0, 0, 0 ],
                      fill: $color.sage
                    }
                  - id: inci.ing.1.texts
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 2 }
                    children:
                      - {
                          id: inci.ing.1.name,
                          type: text,
                          size: [ fill, hug ],
                          fontFamily: Manrope,
                          fontSize: 13.5,
                          fontWeight: 600,
                          color: $color.ink,
                          content: "Ниацинамид 10%"
