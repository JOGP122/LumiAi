                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: "12 компонентов"
                    }
              - id: inci.ing.1
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, gap: 12, alignItems: start }
                children:
