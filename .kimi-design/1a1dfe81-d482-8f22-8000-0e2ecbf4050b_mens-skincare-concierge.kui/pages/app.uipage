              id: product.indicator.bar,
              type: rect,
              size: [ 134, 5 ],
              cornerRadius: 999,
              fill: $color.homeIndicator
            }

prototype: |
  flow home = "screen.home" {
    viewport: [402, 874]
  }
  on click("home.tab.fav") {
    navigate("screen.favorites", transition: none())
  }
  on click("home.tab.cart") {
    navigate("screen.cart", transition: none())
  }
  on click("home.tab.profile") {
    navigate("screen.profile", transition: none())
  }
  on click("fav.tab.home") {
    navigate("screen.home", transition: none())
  }
  on click("fav.tab.cart") {
    navigate("screen.cart", transition: none())
  }
  on click("fav.tab.profile") {
    navigate("screen.profile", transition: none())
  }
  on click("cart.tab.home") {
    navigate("screen.home", transition: none())
  }
  on click("cart.tab.fav") {
    navigate("screen.favorites", transition: none())
  }
  on click("cart.tab.profile") {
    navigate("screen.profile", transition: none())
  }
  on click("prof.tab.home") {
    navigate("screen.home", transition: none())
  }
  on click("prof.tab.fav") {
    navigate("screen.favorites", transition: none())
  }
  on click("prof.tab.cart") {
    navigate("screen.cart", transition: none())
  }
  on click("home.action.scan") {
    navigate("screen.scan", transition: slide("left", 280))
  }
  on click("home.routine.cta") {
    navigate("screen.scan", transition: slide("left", 280))
  }
  on click("home.action.inci") {
    navigate("screen.inci", transition: slide("left", 280))
  }
  on click("home.routine.quiz") {
    navigate("screen.quiz", transition: slide("left", 280))
  }
  on click("prof.scan") {
    navigate("screen.scan", transition: slide("left", 280))
  }
  on click("fav.item.1") {
    navigate("screen.product", transition: slide("left", 280))
  }
  on click("fav.item.2") {
    navigate("screen.product", transition: slide("left", 280))
  }
  on click("cart.item.1") {
    navigate("screen.product", transition: slide("left", 280))
  }
  on click("cart.item.2") {
    navigate("screen.product", transition: slide("left", 280))
  }
  on click("scan.back") {
    back(transition: none())
  }
  on click("inci.back") {
    back(transition: none())
  }
  on click("quiz.back") {
    back(transition: none())
  }
  on click("product.back") {
    back(transition: none())
  }
  on click("scan.capture") {
    navigate("screen.scanResult", transition: slide("left", 280))
  }
  on click("scanResult.close") {
    navigate("screen.home", transition: none())
  }
  on click("scanResult.cta") {
    navigate("screen.home", transition: none())
  }
  on click("quiz.next") {
    navigate("screen.scan", transition: slide("left", 280))
  }
  on click("product.inci") {
    navigate("screen.inci", transition: slide("left", 280))
  }
  on click("product.cta") {
    navigate("screen.cart", transition: none())
  }
