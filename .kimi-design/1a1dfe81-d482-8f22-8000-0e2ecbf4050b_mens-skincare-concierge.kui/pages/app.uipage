                  - {
                      id: prof.streak.title,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 15,
                      fontWeight: 600,
                      color: $color.ivory,
                      content: "Стрик ухода"
                    }
                  - {
                      id: prof.streak.caption,
                      type: text,
                      size: [ 180, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      lineHeight: 16,
                      color: $color.ivoryDim,
                      content: "Сделай первый AI-скан, чтобы начать отсчёт"
                    }
              - {
                  id: prof.streak.value,
                  type: text,
                  size: [ hug, hug ],
                  fontFamily: Cormorant,
                  fontSize: 24,
                  fontWeight: 600,
                  color: $color.ivory,
                  content: "0 дн."
                }
          - id: prof.survey
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 12, padding: 18 }
            fill: $color.surface
            cornerRadius: 20
            effects: $shadow.card
            children:
              - id: prof.survey.header
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
                children:
                  - {
                      id: prof.survey.title,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 15,
                      fontWeight: 600,
                      color: $color.ink,
                      content: "Анкета кожи"
                    }
                  - {
                      id: prof.survey.edit,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 13,
                      fontWeight: 600,
                      color: $color.brass,
                      content: "Изменить"
                    }
              - id: prof.survey.row.1
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: prof.survey.row.1.label,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11.5,
                      color: $color.inkTertiary,
                      content: "Поведение кожи днём"
                    }
                  - {
                      id: prof.survey.row.1.value,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 13.5,
                      lineHeight: 19,
                      color: $color.ink,
                      content: "В целом комфортно, ничего не беспокоит"
                    }
              - { id: prof.survey.div.1, type: rect, size: [ fill, 1 ], fill: $color.line }
              - id: prof.survey.row.2
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: prof.survey.row.2.label,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11.5,
                      color: $color.inkTertiary,
                      content: "Задачи"
                    }
                  - {
                      id: prof.survey.row.2.value,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 13.5,
                      lineHeight: 19,
                      color: $color.ink,
                      content: "Базовый уход на каждый день, чёрные точки и поры, воспаления"
                    }
              - { id: prof.survey.div.2, type: rect, size: [ fill, 1 ], fill: $color.line }
              - id: prof.survey.row.3
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: prof.survey.row.3.label,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11.5,
                      color: $color.inkTertiary,
                      content: "Бюджет на средство"
                    }
                  - {
                      id: prof.survey.row.3.value,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 13.5,
                      lineHeight: 19,
                      color: $color.ink,
                      content: "1 000 – 2 500 ₽"
                    }
          - id: prof.history
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 12 }
            children:
              - id: prof.history.header
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
                children:
                  - {
                      id: prof.history.title,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 15,
                      fontWeight: 600,
                      color: $color.ink,
                      content: "История сканирований"
                    }
                  - {
                      id: prof.history.new,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 13,
                      fontWeight: 600,
                      color: $color.brass,
                      content: "+ Новый анализ"
                    }
              - id: prof.history.empty
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, padding: [ 18, 20 ] }
                fill: $color.sunken
                cornerRadius: 16
                children:
                  - {
                      id: prof.history.empty.text,
                      type: text,
                      size: [ 318, hug ],
                      fontFamily: Manrope,
                      fontSize: 13,
                      lineHeight: 18,
                      color: $color.inkSecondary,
                      align: [ center, top ],
                      content: "Пока пусто — проведи первый AI-скан кожи"
                    }
          - id: prof.scan
            type: instance
            source: button
            size: [ fill, 52 ]
            values:
              label: "Запустить AI-скан кожи"
              icon:
                - {
                    id: prof.scan.icon,
                    type: svg,
                    size: [ 15, 15 ],
                    icon: "fas:face-smile",
                    fill: $color.onBtnPrimary
                  }
          - {
              id: prof.reset,
              type: text,
              size: [ hug, hug ],
              alignSelf: center,
              fontFamily: Manrope,
              fontSize: 13,
              fontWeight: 600,
              color: $color.danger,
              content: "Сбросить профиль и начать заново"
            }
      - id: prof.tabbar
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column }
        children:
          - { id: prof.tabbar.line, type: rect, size: [ fill, 1 ], fill: $color.line }
          - id: prof.tabbar.items
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, padding: [ 13, 28, 16, 28 ], justifyContent: spaceBetween }
            children:
              - id: prof.tab.home
                type: instance
                source: tab-item
                values:
                  icon:
                    - {
                        id: prof.tab.home.icon,
                        type: svg,
                        size: [ 21, 21 ],
                        icon: "fas:house",
                        fill: $color.inkTertiary
                      }
              - id: prof.tab.fav
                type: instance
                source: tab-item
                values:
                  icon:
                    - {
                        id: prof.tab.fav.icon,
                        type: svg,
                        size: [ 21, 21 ],
                        icon: "far:heart",
                        fill: $color.inkTertiary
                      }
              - id: prof.tab.cart
                type: instance
                source: tab-item
                values:
                  icon:
                    - {
                        id: prof.tab.cart.icon,
                        type: svg,
                        size: [ 21, 21 ],
                        icon: "fas:bag-shopping",
                        fill: $color.inkTertiary
                      }
              - id: prof.tab.profile
                type: instance
                source: tab-item
                values:
                  active: true
                  icon:
                    - {
                        id: prof.tab.profile.icon,
                        type: svg,
                        size: [ 21, 21 ],
                        icon: "fas:user",
                        fill: $color.ink
                      }
      - id: prof.indicator
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, padding: [ 4, 0, 8, 0 ], justifyContent: center }
        children:
          - {
              id: prof.indicator.bar,
              type: rect,
              size: [ 134, 5 ],
              cornerRadius: 999,
              fill: $color.homeIndicator
            }

  - id: note.scan
    type: text
    position: [ 80, 1532 ]
    size: [ hug, hug ]
    fontFamily: Manrope
    fontSize: 34
    fontWeight: 700
    color: "#000000"
    content: AI-скан

  - id: screen.scan
    type: frame
    position: [ 80, 1600 ]
    size: [ 402, hug ]
    layout: { type: flex, direction: column }
    fill: $color.canvas
    children:
      - id: scan.content
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 20, padding: [ 24, 20, 28, 20 ] }
        children:
          - id: scan.header
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 14, alignItems: center }
            children:
              - id: scan.back
                type: instance
                source: icon-button
                values:
                  icon:
                    - {
                        id: scan.back.icon,
                        type: svg,
                        size: [ 14, 14 ],
                        icon: "fas:chevron-left",
                        fill: $color.ink
                      }
              - id: scan.header.texts
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 4 }
                children:
                  - {
                      id: scan.header.overline,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.overline,
                      content: "ДИАГНОСТИКА"
                    }
                  - {
                      id: scan.header.title,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Cormorant,
                      fontSize: 26,
                      fontWeight: 500,
                      lineHeight: 30,
                      color: $color.ink,
                      content: "AI-скан кожи"
                    }
          - id: scan.viewfinder
            type: frame
            size: [ fill, 380 ]
            layout: { type: free, overflow: hidden }
            fill: $color.dark
            cornerRadius: 20
            effects: $shadow.card
            children:
              - {
                  id: scan.face,
                  type: ellipse,
                  position: [ 91, 58 ],
                  size: [ 180, 240 ],
                  stroke: { color: $color.brassLight, width: 1.5, style: dash }
                }
              - {
                  id: scan.line,
                  type: rect,
                  position: [ 40, 190 ],
                  size: [ 282, 2 ],
                  cornerRadius: 1,
                  fill:
                    {
                      type: linearGradient,
                      angle: 0,
                      stops: [ [ 0, "#CDA87200" ], [ 0.5, "#CDA872" ], [ 1, "#CDA87200" ] ]
                    }
                }
              - {
                  id: scan.hint,
                  type: text,
                  position: [ 0, 328 ],
                  size: [ 362, hug ],
                  fontFamily: Manrope,
                  fontSize: 12,
                  color: $color.ivoryDim,
                  align: [ center, top ],
                  content: "Расположи лицо в овале"
                }
          - id: scan.tips
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 4, padding: [ 14, 18 ] }
            fill: $color.surface
            cornerRadius: 20
            effects: $shadow.card
            children:
              - id: scan.tip.1
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, gap: 12, padding: [ 8, 0 ], alignItems: center }
                children:
                  - id: scan.tip.1.tile
                    type: frame
                    size: [ 36, 36 ]
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    fill: $color.brassSoft
                    cornerRadius: 10
                    children:
                      - {
                          id: scan.tip.1.icon,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: "fas:sun",
                          fill: $color.brassDeep
                        }
                  - {
                      id: scan.tip.1.text,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 13.5,
                      lineHeight: 19,
                      color: $color.ink,
                      content: "Дневной свет, без фильтров"
                    }
              - id: scan.tip.2
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, gap: 12, padding: [ 8, 0 ], alignItems: center }
                children:
                  - id: scan.tip.2.tile
                    type: frame
                    size: [ 36, 36 ]
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    fill: $color.brassSoft
                    cornerRadius: 10
                    children:
                      - {
                          id: scan.tip.2.icon,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: "fas:droplet",
                          fill: $color.brassDeep
                        }
                  - {
                      id: scan.tip.2.text,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 13.5,
                      lineHeight: 19,
                      color: $color.ink,
                      content: "Чистая кожа, без макияжа"
                    }
              - id: scan.tip.3
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, gap: 12, padding: [ 8, 0 ], alignItems: center }
                children:
                  - id: scan.tip.3.tile
                    type: frame
                    size: [ 36, 36 ]
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    fill: $color.brassSoft
                    cornerRadius: 10
                    children:
                      - {
                          id: scan.tip.3.icon,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: "fas:camera",
                          fill: $color.brassDeep
                        }
                  - {
                      id: scan.tip.3.text,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 13.5,
                      lineHeight: 19,
                      color: $color.ink,
                      content: "Камера на уровне глаз"
                    }
          - id: scan.capture
            type: instance
            source: button
            size: [ fill, 52 ]
            values:
              label: "Снять селфи"
              icon:
                - {
                    id: scan.capture.icon,
                    type: svg,
                    size: [ 15, 15 ],
                    icon: "fas:camera",
                    fill: $color.onBtnPrimary
                  }
          - id: scan.upload
            type: instance
            source: button
            size: [ fill, 52 ]
            values: { kind: outline, label: "Загрузить из галереи" }
          - {
              id: scan.privacy,
              type: text,
              size: [ fill, hug ],
              fontFamily: Manrope,
              fontSize: 12,
              lineHeight: 16,
              color: $color.inkTertiary,
              align: [ center, top ],
              content: "Фото обрабатывается локально и не сохраняется"
            }
      - id: scan.indicator
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, padding: [ 4, 0, 8, 0 ], justifyContent: center }
        children:
          - {
              id: scan.indicator.bar,
              type: rect,
              size: [ 134, 5 ],
              cornerRadius: 999,
              fill: $color.homeIndicator
            }

  - id: note.scanresult
    type: text
    position: [ 562, 1532 ]
    size: [ hug, hug ]
    fontFamily: Manrope
    fontSize: 34
    fontWeight: 700
    color: "#000000"
    content: Результат скана

  - id: screen.scanResult
    type: frame
    position: [ 562, 1600 ]
    size: [ 402, hug ]
    layout: { type: flex, direction: column }
    fill: $color.canvas
    children:
      - id: scanResult.content
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 20, padding: [ 24, 20, 28, 20 ] }
        children:
          - id: scanResult.header
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 14, alignItems: center }
            children:
              - id: scanResult.close
                type: instance
                source: icon-button
                values:
                  icon:
                    - {
                        id: scanResult.close.icon,
                        type: svg,
                        size: [ 14, 14 ],
                        icon: "fas:xmark",
                        fill: $color.ink
                      }
              - id: scanResult.header.texts
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 4 }
                children:
                  - {
                      id: scanResult.header.overline,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.overline,
                      content: "РЕЗУЛЬТАТ АНАЛИЗА"
                    }
                  - {
                      id: scanResult.header.title,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Cormorant,
                      fontSize: 26,
                      fontWeight: 500,
                      lineHeight: 30,
                      color: $color.ink,
                      content: "Индекс кожи"
                    }
          - id: scanResult.score
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 14, padding: 22 }
            fill: $color.dark
            cornerRadius: 20
            effects: $shadow.card
            children:
              - id: scanResult.score.top
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, justifyContent: spaceBetween, alignItems: end }
                children:
                  - id: scanResult.score.left
                    type: frame
                    size: [ hug, hug ]
                    layout: { type: flex, direction: column, gap: 6 }
                    children:
                      - {
                          id: scanResult.score.overline,
                          type: text,
                          size: [ hug, hug ],
                          style: $text.overline,
                          color: $color.brassLight,
                          content: "ОБЩИЙ ИНДЕКС"
                        }
                      - id: scanResult.score.row
                        type: frame
                        size: [ hug, hug ]
                        layout: { type: flex, gap: 6, alignItems: end }
                        children:
                          - {
                              id: scanResult.score.value,
                              type: text,
                              size: [ hug, hug ],
                              fontFamily: Cormorant,
                              fontSize: 52,
                              fontWeight: 600,
                              lineHeight: 52,
                              color: $color.ivory,
                              content: "78"
                            }
                          - {
                              id: scanResult.score.max,
                              type: text,
                              size: [ hug, hug ],
                              margin: [ 0, 0, 4, 0 ],
                              fontFamily: Manrope,
                              fontSize: 14,
                              color: $color.ivoryDim,
                              content: "/ 100"
                            }
                  - id: scanResult.score.chip
                    type: instance
                    source: chip
                    values: { kind: soft, label: "Хорошее состояние" }
              - id: scanResult.score.track
                type: frame
                size: [ fill, 4 ]
                layout: { type: free, overflow: hidden }
                fill: $color.darkSoft
                cornerRadius: 999
                children:
                  - {
                      id: scanResult.score.fill,
                      type: rect,
                      position: [ 0, 0 ],
                      size: [ "78%", 4 ],
                      cornerRadius: 999,
                      fill: $color.brass
                    }
              - {
                  id: scanResult.score.caption,
                  type: text,
                  size: [ hug, hug ],
                  fontFamily: Manrope,
                  fontSize: 12,
                  color: $color.ivoryDim,
                  content: "Скан от 15 ноября, 14:20"
                }
          - id: scanResult.metrics
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 14, padding: 18 }
            fill: $color.surface
            cornerRadius: 20
            effects: $shadow.card
            children:
              - {
                  id: scanResult.metrics.title,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.headline,
                  fontSize: 15,
                  content: "Метрики"
                }
              - id: scanResult.metric.1
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - id: scanResult.metric.1.row
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
                    children:
                      - {
                          id: scanResult.metric.1.label,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          color: $color.inkSecondary,
                          content: "Увлажнённость"
                        }
                      - {
                          id: scanResult.metric.1.value,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          fontWeight: 700,
                          color: $color.ink,
                          content: "82"
                        }
                  - id: scanResult.metric.1.track
                    type: frame
                    size: [ fill, 3 ]
                    layout: { type: free, overflow: hidden }
                    fill: $color.sunken
                    cornerRadius: 999
                    children:
                      - {
                          id: scanResult.metric.1.fill,
                          type: rect,
                          position: [ 0, 0 ],
                          size: [ "82%", 3 ],
                          cornerRadius: 999,
                          fill: $color.sage
                        }
              - id: scanResult.metric.2
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - id: scanResult.metric.2.row
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
                    children:
                      - {
                          id: scanResult.metric.2.label,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          color: $color.inkSecondary,
                          content: "Тон и текстура"
                        }
                      - {
                          id: scanResult.metric.2.value,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          fontWeight: 700,
                          color: $color.ink,
                          content: "74"
                        }
                  - id: scanResult.metric.2.track
                    type: frame
                    size: [ fill, 3 ]
                    layout: { type: free, overflow: hidden }
                    fill: $color.sunken
                    cornerRadius: 999
                    children:
                      - {
                          id: scanResult.metric.2.fill,
                          type: rect,
                          position: [ 0, 0 ],
                          size: [ "74%", 3 ],
                          cornerRadius: 999,
                          fill: $color.brass
                        }
              - id: scanResult.metric.3
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - id: scanResult.metric.3.row
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
                    children:
                      - {
                          id: scanResult.metric.3.label,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          color: $color.inkSecondary,
                          content: "Поры"
                        }
                      - {
                          id: scanResult.metric.3.value,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          fontWeight: 700,
                          color: $color.ink,
                          content: "68"
                        }
                  - id: scanResult.metric.3.track
                    type: frame
                    size: [ fill, 3 ]
                    layout: { type: free, overflow: hidden }
                    fill: $color.sunken
                    cornerRadius: 999
                    children:
                      - {
                          id: scanResult.metric.3.fill,
                          type: rect,
                          position: [ 0, 0 ],
                          size: [ "68%", 3 ],
                          cornerRadius: 999,
                          fill: $color.brass
                        }
              - id: scanResult.metric.4
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - id: scanResult.metric.4.row
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, justifyContent: spaceBetween, alignItems: center }
                    children:
                      - {
                          id: scanResult.metric.4.label,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          color: $color.inkSecondary,
                          content: "Воспаления"
                        }
                      - {
                          id: scanResult.metric.4.value,
                          type: text,
                          size: [ hug, hug ],
                          fontFamily: Manrope,
                          fontSize: 13,
                          fontWeight: 700,
                          color: $color.ink,
                          content: "91"
                        }
                  - id: scanResult.metric.4.track
                    type: frame
                    size: [ fill, 3 ]
                    layout: { type: free, overflow: hidden }
                    fill: $color.sunken
                    cornerRadius: 999
                    children:
                      - {
                          id: scanResult.metric.4.fill,
                          type: rect,
                          position: [ 0, 0 ],
                          size: [ "91%", 3 ],
                          cornerRadius: 999,
                          fill: $color.sage
                        }
          - id: scanResult.advice
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 6, padding: 16 }
            fill: $color.brassSoft
            cornerRadius: 16
            children:
              - {
                  id: scanResult.advice.overline,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.overline,
                  color: $color.brassDeep,
                  content: "РЕКОМЕНДАЦИЯ КОНСЕРЖА"
                }
              - {
                  id: scanResult.advice.text,
                  type: text,
                  size: [ fill, hug ],
                  fontFamily: Manrope,
                  fontSize: 13,
                  lineHeight: 19,
                  color: $color.ink,
                  content: "Лёгкое увлажнение утром, мягкое очищение вечером и SPF каждый день —
                    даже зимой."
                }
          - id: scanResult.cta
            type: instance
            source: button
            size: [ fill, 52 ]
            values:
              label: "Сформировать уход"
              icon:
                - {
                    id: scanResult.cta.icon,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: "fas:wand-magic-sparkles",
                    fill: $color.onBtnPrimary
                  }
          - {
              id: scanResult.saved,
              type: text,
              size: [ fill, hug ],
              fontFamily: Manrope,
              fontSize: 12,
              color: $color.inkTertiary,
              align: [ center, top ],
              content: "Результат сохранён в истории сканирований"
            }
      - id: scanResult.indicator
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, padding: [ 4, 0, 8, 0 ], justifyContent: center }
        children:
          - {
              id: scanResult.indicator.bar,
              type: rect,
              size: [ 134, 5 ],
              cornerRadius: 999,
              fill: $color.homeIndicator
            }

