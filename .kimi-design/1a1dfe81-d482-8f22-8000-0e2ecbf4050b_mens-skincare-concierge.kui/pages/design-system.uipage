name: Дизайн-система

children:
  - id: note.colors
    type: text
    position: [ 80, 82 ]
    size: [ hug, hug ]
    fontFamily: Manrope
    fontSize: 34
    fontWeight: 700
    color: "#000000"
    content: 01 — Цвет

  - id: ds.colors
    type: frame
    position: [ 80, 150 ]
    size: [ 760, hug ]
    layout: { type: flex, direction: column, gap: 28, padding: 32 }
    fill: $color.surface
    cornerRadius: 24
    children:
      - id: ds.colors.title
        type: text
        size: [ hug, hug ]
        style: $text.title
        content: Цвет
      - id: ds.colors.base
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 12 }
        children:
          - {
              id: ds.colors.base.label,
              type: text,
              size: [ hug, hug ],
              style: $text.overline,
              content: ОСНОВА
            }
          - id: ds.colors.base.row
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 16 }
            children:
              - id: sw.canvas
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.canvas.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.canvas,
                      stroke: { color: $color.line, width: 1, alignment: inside }
                    }
                  - {
                      id: sw.canvas.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Canvas
                    }
                  - {
                      id: sw.canvas.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#F4F0E8"
                    }
              - id: sw.surface
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.surface.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.surface,
                      stroke: { color: $color.line, width: 1, alignment: inside }
                    }
                  - {
                      id: sw.surface.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Surface
                    }
                  - {
                      id: sw.surface.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#FCFAF4"
                    }
              - id: sw.sunken
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.sunken.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.sunken
                    }
                  - {
                      id: sw.sunken.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Sunken
                    }
                  - {
                      id: sw.sunken.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#ECE5D7"
                    }
              - id: sw.dark
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.dark.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.dark
                    }
                  - {
                      id: sw.dark.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Dark
                    }
                  - {
                      id: sw.dark.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#1C1813"
                    }
              - id: sw.darksoft
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.darksoft.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.darkSoft
                    }
                  - {
                      id: sw.darksoft.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Dark Soft
                    }
                  - {
                      id: sw.darksoft.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#322B22"
                    }
      - id: ds.colors.text
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 12 }
        children:
          - {
              id: ds.colors.text.label,
              type: text,
              size: [ hug, hug ],
              style: $text.overline,
              content: ТЕКСТ
            }
          - id: ds.colors.text.row
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 16 }
            children:
              - id: sw.ink
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.ink.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.ink
                    }
                  - {
                      id: sw.ink.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Ink
                    }
                  - {
                      id: sw.ink.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#1C1813"
                    }
              - id: sw.inksec
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.inksec.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.inkSecondary
                    }
                  - {
                      id: sw.inksec.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Ink Secondary
                    }
                  - {
                      id: sw.inksec.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#756C5D"
                    }
              - id: sw.inkter
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.inkter.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.inkTertiary
                    }
                  - {
                      id: sw.inkter.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Ink Tertiary
                    }
                  - {
                      id: sw.inkter.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#A79C8A"
                    }
              - id: sw.ivory
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.ivory.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.ivory,
                      stroke: { color: $color.line, width: 1, alignment: inside }
                    }
                  - {
                      id: sw.ivory.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Ivory
                    }
                  - {
                      id: sw.ivory.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#F5F0E5"
                    }
              - id: sw.ivorydim
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.ivorydim.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.ivoryDim
                    }
                  - {
                      id: sw.ivorydim.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Ivory Dim
                    }
                  - {
                      id: sw.ivorydim.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#B4A993"
                    }
      - id: ds.colors.accent
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 12 }
        children:
          - {
              id: ds.colors.accent.label,
              type: text,
              size: [ hug, hug ],
              style: $text.overline,
              content: АКЦЕНТЫ
            }
          - id: ds.colors.accent.row
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 16 }
            children:
              - id: sw.brass
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.brass.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.brass
                    }
                  - {
                      id: sw.brass.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Brass
                    }
                  - {
                      id: sw.brass.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#A87C44"
                    }
              - id: sw.brassdeep
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.brassdeep.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.brassDeep
                    }
                  - {
                      id: sw.brassdeep.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Brass Deep
                    }
                  - {
                      id: sw.brassdeep.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#84622F"
                    }
              - id: sw.brasssoft
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.brasssoft.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.brassSoft
                    }
                  - {
                      id: sw.brasssoft.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Brass Soft
                    }
                  - {
                      id: sw.brasssoft.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#F0E6D1"
                    }
              - id: sw.sage
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.sage.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.sage
                    }
                  - {
                      id: sw.sage.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Sage
                    }
                  - {
                      id: sw.sage.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#5F7A60"
                    }
              - id: sw.terra
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 8 }
                children:
                  - {
                      id: sw.terra.chip,
                      type: rect,
                      size: [ 120, 64 ],
                      cornerRadius: 12,
                      fill: $color.terracotta
                    }
                  - {
                      id: sw.terra.name,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Terracotta
                    }
                  - {
                      id: sw.terra.hex,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 11,
                      color: $color.inkTertiary,
                      content: "#C05F3C"
                    }

  - id: note.typography
    type: text
    position: [ 920, 82 ]
    size: [ hug, hug ]
    fontFamily: Manrope
    fontSize: 34
    fontWeight: 700
    color: "#000000"
    content: 02 — Типографика

  - id: ds.typography
    type: frame
    position: [ 920, 150 ]
    size: [ 600, hug ]
    layout: { type: flex, direction: column, gap: 24, padding: 32 }
    fill: $color.surface
    cornerRadius: 24
    children:
      - id: ds.typo.title
        type: text
        size: [ hug, hug ]
        style: $text.title
        content: Типографика
      - id: ds.typo.pair
        type: text
        size: [ fill, hug ]
        style: $text.body
        color: $color.inkSecondary
        content: Cormorant — акцидентная антиква для заголовков и цифр. Manrope —
          гротеск для интерфейсного текста. Оба шрифта поддерживают кириллицу.
      - id: ds.typo.display
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 6 }
        children:
          - {
              id: ds.typo.display.spec,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: Display — Cormorant 34/38
            }
          - {
              id: ds.typo.display.sample,
              type: text,
              size: [ fill, hug ],
              style: $text.display,
              content: Лаконичный уход
            }
      - id: ds.typo.title2
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 6 }
        children:
          - {
              id: ds.typo.title2.spec,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: Title — Cormorant 26/30
            }
          - {
              id: ds.typo.title2.sample,
              type: text,
              size: [ fill, hug ],
              style: $text.title,
              content: Индекс кожи
            }
      - id: ds.typo.headline
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 6 }
        children:
          - {
              id: ds.typo.headline.spec,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: "Headline — Manrope 16/22, semibold"
            }
          - {
              id: ds.typo.headline.sample,
              type: text,
              size: [ fill, hug ],
              style: $text.headline,
              content: AI-диагностика кожи лица
            }
      - id: ds.typo.body
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 6 }
        children:
          - {
              id: ds.typo.body.spec,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: Body — Manrope 14/21
            }
          - {
              id: ds.typo.body.sample,
              type: text,
              size: [ fill, hug ],
              style: $text.body,
              content: Селфи-анализ и персональный подбор средств под твою кожу и бюджет.
            }
      - id: ds.typo.caption
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 6 }
        children:
          - {
              id: ds.typo.caption.spec,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: Caption — Manrope 12.5/17
            }
          - {
              id: ds.typo.caption.sample,
              type: text,
              size: [ fill, hug ],
              style: $text.caption,
              content: INCI-сканер комедогенности и конфликта активов
            }
      - id: ds.typo.overline
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 6 }
        children:
          - {
              id: ds.typo.overline.spec,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: "Overline — Manrope 11/14, bold, tracking 1.8"
            }
          - {
              id: ds.typo.overline.sample,
              type: text,
              size: [ fill, hug ],
              style: $text.overline,
              content: МУЖСКОЙ КОНСЬЕРЖ
            }

  - id: note.components
    type: text
    position: [ 80, 900 ]
    size: [ hug, hug ]
    fontFamily: Manrope
    fontSize: 34
    fontWeight: 700
    color: "#000000"
    content: 03 — Компоненты

  - id: ds.components
    type: frame
    position: [ 80, 968 ]
    size: [ 760, hug ]
    layout: { type: flex, direction: column, gap: 28, padding: 32 }
    fill: $color.surface
    cornerRadius: 24
    children:
      - id: ds.comp.title
        type: text
        size: [ hug, hug ]
        style: $text.title
        content: Компоненты
      - id: ds.comp.buttons
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 12 }
        children:
          - {
              id: ds.comp.buttons.label,
              type: text,
              size: [ hug, hug ],
              style: $text.overline,
              content: КНОПКИ
            }
          - id: ds.comp.buttons.row
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 12, alignItems: center }
            children:
              - id: ds.comp.btn.primary
                type: instance
                source: button
                values:
                  label: Провести AI-скан
                  icon:
                    - {
                        id: ds.comp.btn.primary.icon,
                        type: svg,
                        size: [ 15, 15 ],
                        icon: "fas:face-smile",
                        fill: $color.ivory
                      }
              - id: ds.comp.btn.brass
                type: instance
                source: button
                values: { kind: brass, label: В корзину }
              - id: ds.comp.btn.outline
                type: instance
                source: button
                values: { kind: outline, label: Подробнее }
      - id: ds.comp.chips
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 12 }
        children:
          - {
              id: ds.comp.chips.label,
              type: text,
              size: [ hug, hug ],
              style: $text.overline,
              content: ЧИПСЫ
            }
          - id: ds.comp.chips.row
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 10, alignItems: center }
            children:
              - id: ds.comp.chip.active
                type: frame
                size: [ hug, 36 ]
                layout: { type: flex, gap: 8, padding: [ 0, 16 ], alignItems: center }
                fill: $color.dark
                cornerRadius: 999
                children:
                  - {
                      id: ds.comp.chip.active.dot,
                      type: ellipse,
                      size: [ 6, 6 ],
                      fill: $color.brassLight
                    }
                  - {
                      id: ds.comp.chip.active.text,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 13,
                      fontWeight: 600,
                      color: $color.ivory,
                      content: Золотое Яблоко
                    }
              - id: ds.comp.chip.default
                type: frame
                size: [ hug, 36 ]
                layout: { type: flex, padding: [ 0, 16 ], alignItems: center }
                cornerRadius: 999
                stroke: { color: $color.line, width: 1, alignment: inside }
                children:
                  - {
                      id: ds.comp.chip.default.text,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 13,
                      fontWeight: 500,
                      color: $color.inkSecondary,
                      content: Лэтуаль
                    }
              - id: ds.comp.chip.soft
                type: frame
                size: [ hug, 36 ]
                layout: { type: flex, gap: 8, padding: [ 0, 16 ], alignItems: center }
                fill: $color.brassSoft
                cornerRadius: 999
                children:
                  - {
                      id: ds.comp.chip.soft.icon,
                      type: svg,
                      size: [ 13, 13 ],
                      icon: "fas:medal",
                      fill: $color.brassDeep
                    }
                  - {
                      id: ds.comp.chip.soft.text,
                      type: text,
                      size: [ hug, hug ],
                      fontFamily: Manrope,
                      fontSize: 13,
                      fontWeight: 600,
                      color: $color.brassDeep,
                      content: "Мужской уход, 18–24"
                    }
      - id: ds.comp.rows
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 12 }
        children:
          - {
              id: ds.comp.rows.label,
              type: text,
              size: [ hug, hug ],
              style: $text.overline,
              content: СТРОКА ДЕЙСТВИЯ
            }
          - id: ds.comp.row.demo
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, gap: 14, padding: [ 16, 18 ], alignItems: center }
            fill: $color.canvas
            cornerRadius: 16
            children:
              - id: ds.comp.row.tile
                type: frame
                size: [ 42, 42 ]
                layout: { type: flex, alignItems: center, justifyContent: center }
                fill: $color.brassSoft
                cornerRadius: 12
                children:
                  - {
                      id: ds.comp.row.tile.icon,
                      type: svg,
                      size: [ 17, 17 ],
                      icon: "fas:flask",
                      fill: $color.brassDeep
                    }
              - id: ds.comp.row.texts
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 3 }
                children:
                  - {
                      id: ds.comp.row.title,
                      type: text,
                      size: [ fill, hug ],
                      fontFamily: Manrope,
                      fontSize: 15,
                      fontWeight: 600,
                      color: $color.ink,
                      content: Проверить банку по фото
                    }
                  - {
                      id: ds.comp.row.caption,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.caption,
                      content: Разбор состава по INCI
                    }
              - {
                  id: ds.comp.row.chevron,
