# MOONSHOT_API_KEY: ключ с платформы Moonshot AI (https://platform.moonshot.ai).
# Бесплатный стартовый кредит (~¥15) покрывает бета-тест; лимит Tier 0 — 3 RPM.
# Без ключа AI-эндпоинты (/api/analyze-face, /api/analyze-product) не работают.
# Модель по умолчанию — kimi-k2.6 (vision + JSON mode). Переопределить: LUMI_AI_MODEL=...
MOONSHOT_API_KEY=""

# APP_URL: публичный URL приложения (нужен для вебхука Telegram на проде).
APP_URL=""

# TELEGRAM_BOT_TOKEN: токен бота от @BotFather (можно также задать в профиле приложения)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="lum_betai_ai_bot"
